# Ollama — local inference. Start it with: ollama serve
OLLAMA_HOST=http://localhost:11434

# Vision-language tiers. Pull them first:
#   ollama pull qwen2.5vl:3b && ollama pull qwen2.5vl:7b
# Confirm with: uv run python scripts/verify_ollama.py
CLEARWAY_MODEL_FAST=qwen2.5vl:3b
CLEARWAY_MODEL_DEEP=qwen2.5vl:7b

# Multi-vector page retrieval. Apache-2.0; needs: uv sync --extra retrieval
CLEARWAY_RETRIEVER=vidore/colqwen2-v1.0

# AISStream — free key from https://aisstream.io (sign up, no card)
AISSTREAM_API_KEY=

# Where the collector writes. Kept out of git by .gitignore.
CLEARWAY_AIS_DB=data/ais.sqlite3
