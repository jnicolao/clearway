# Anthropic — extraction and the critic pass
ANTHROPIC_API_KEY=

# Jina — multi-vector page embeddings (https://jina.ai/embeddings)
JINA_API_KEY=

# Model tiers. Defaults are the bulk/escalation pair; override to experiment.
CLEARWAY_MODEL_FAST=claude-haiku-4-5
CLEARWAY_MODEL_DEEP=claude-opus-5
CLEARWAY_MODEL_EMBED=jina-embeddings-v4

# AISStream — free key from https://aisstream.io (sign up, no card)
AISSTREAM_API_KEY=

# Where the collector writes. Kept out of git by .gitignore.
CLEARWAY_AIS_DB=data/ais.sqlite3
